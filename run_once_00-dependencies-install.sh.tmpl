#!/usr/bin/env bash

{{ template "statusbar.tmpl" . }}
{{ template "sudo.tmpl" . }}
{{ template "pkg_install.tmpl" . }}

status_start
if [[ $PKG_MGR == "pacman" ]]; then
  ### pacman theming
  sudo grep "Color" /etc/pacman.conf 2>&1 >/dev/null && sudo sed -i '/Color/d' /etc/pacman.conf
  sudo grep "ILoveCandy" /etc/pacman.conf 2>&1 >/dev/null && sudo sed -i '/ILoveCandy/d' /etc/pacman.conf
  sudo sed -i '/^\[options\]$/a Color\nILoveCandy' /etc/pacman.conf
  ### reflector
  status "Installing reflector and choosing best mirrors"
  echo "Installing reflector..."
  if ! pacman -Qi reflector &>/dev/null; then
    sudo pacman -S --needed --noconfirm reflector
  fi
  sudo reflector --latest 15 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
  sudo systemctl enable --now reflector.timer
  sudo pacman -Sy --noconfirm archlinux-keyring
  if [ -f /etc/os-release ] && grep -q 'ID="artix"' /etc/os-release; then
      sudo pacman -S --noconfirm artix-archlinux-support
      sudo pacman-key --populate archlinux
  fi
  ### multilib
  status "Adding multilib to pacman.conf"
  echo "Installing multilib..."
  if [[ $(awk 'prev == "#[multilib]" && $0 == "#Include = /etc/pacman.d/mirrorlist" {print "0"; exit 0} {prev = $0} END {exit 1}' /etc/pacman.conf ) == "0" ]]; then
    sudo sed -i -z 's/#\[multilib\]\n#Include = \/etc\/pacman.d\/mirrorlist/\[multilib\]\nInclude = \/etc\/pacman.d\/mirrorlist/g' /etc/pacman.conf
  elif [[ $(awk 'prev == "[multilib]" && $0 == "Include = /etc/pacman.d/mirrorlist" {print "0"; exit 0} {prev = $0} END {exit 1}' /etc/pacman.conf ) != "0" ]]; then 
    echo "[multilib]" | sudo tee -a /etc/pacman.conf > /dev/null
    echo "Include = /etc/pacman.d/mirrorlist" | sudo tee -a /etc/pacman.conf > /dev/null
  fi;
  status "Updating pacman databases"
  echo "Updating pacman databases..."
  sudo pacman -Sy --noconfirm
  ### yay install
  status "Installing AUR helper yay"
  echo "Installing yay..."
  if [[ $(pacman -Qe yay 2>&1 | awk '{print $1}') == "error:" ]]; then
    sudo pacman -S --needed --noconfirm base-devel git
    if [ -d "/tmp/yay" ]; then
      git -C /tmp/yay pull
    else
      git clone https://aur.archlinux.org/yay.git /tmp/yay
    fi;
    makepkg -D /tmp/yay -si --noconfirm
    rm -rf /tmp/yay
  fi;
  ### flatpak install
  status "Installing flatpak"
  echo "Installing flatpak..."
  sudo pacman -S --needed --noconfirm flatpak
  flatpak remote-add --if-not-exists flathub https://flathub.org
  ### xdg
  status "Installing xdg menu"
  echo "Installing xdg menu..."
  sudo pacman -S --needed --noconfirm archlinux-xdg-menu kservice
  sudo ln -sf /etc/xdg/menus/arch-applications.menu /etc/xdg/menus/applications.menu
  rm -f ~/.cache/ksycoca6_*
  ### updating all
  status "Updating pacman packages"
  echo "Updating pacman packages..."
  sudo pacman -Syu --noconfirm
fi;

status "Installing linux headers"
echo "Installing headers..."
if [[ $(uname -r | grep "lts") != "" ]]; then 
  pkg_install "linux-lts-headers"
elif [[ $(uname -r | grep "zen") != "" ]]; then
  pkg_install "linux-zen-headers" 
else
  pkg_install "linux-headers"
fi
status_stop
