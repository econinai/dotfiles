grub_add_params() {
    local file=/etc/default/grub
    local params=$1

    if [[ -z $params ]]; then
        return 1
    fi
    if ! grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file"; then
        return 1
    fi

    local current
    current=$(grep -m1 '^GRUB_CMDLINE_LINUX_DEFAULT=' "$file" \
        | sed -E "s/^GRUB_CMDLINE_LINUX_DEFAULT=//; s/^[\"']//; s/[\"'][[:space:]]*$//")

    local -a cur=($current) out=()
    local p key w
    for p in $params; do
        key=${p%%=*}
        out=()
        for w in "${cur[@]}"; do
            [[ ${w%%=*} == "$key" ]] || out+=("$w")
        done
        cur=("${out[@]}" "$p")
    done

    local new="${cur[*]}"
    if [[ $new == "$current" ]]; then
        return 0
    fi

    local esc
    esc=$(printf '%s' "$new" | sed 's/[&|\\]/\\&/g')

    sudo cp -a "$file" "$file.bak" || return 1
    sudo sed -i -E "s|^(GRUB_CMDLINE_LINUX_DEFAULT=).*|\1\"${esc}\"|" "$file" || return 1
}


update_grub() {
  if command -v update-grub > /dev/null; then
    sudo update-grub
  elif command -v grub-mkconfig > /dev/null; then
    sudo grub-mkconfig -o /boot/grub/grub.cfg
  elif command -v zypper > /dev/null || command -v transactional-update > /dev/null; then
    sudo grub2-mkconfig -o /boot/grub2/grub.cfg
  elif command -v dnf > /dev/null || command -v rpm-ostree > /dev/null; then
    if [[ -f /boot/efi/EFI/fedora/grub.cfg ]]; then
      sudo grub2-mkconfig -o /boot/efi/EFI/fedora/grub.cfg
    elif [[ -f /boot/grub2/grub.cfg ]]; then
      sudo grub2-mkconfig -o /boot/grub2/grub.cfg
	fi
  fi
}
