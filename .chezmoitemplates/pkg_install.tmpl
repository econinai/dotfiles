for PKG_MGR in pacman apt dnf zypper apk; do command -v $PKG_MGR &>/dev/null && break; done

diff_words() {
    local list1=$(echo "$1" | tr ' ' '\n' | sort -u)
    local list2=$(echo "$2" | tr ' ' '\n' | sort -u)
    comm -3 <(echo "$list1") <(echo "$list2") | tr -d '\t' | tr '\n' ' ' | xargs
}

filter_pacman() {
  for p in $1; do
    pacman -Si "$p" &>/dev/null && echo "$p"
  done | xargs
}

filter_yay() {
  for p in $1; do
    yay -Si "$p" &>/dev/null && echo "$p"
  done | xargs
}

filter_installed() {
  for p in $1; do
    pacman -Qq "$p" &>/dev/null && echo "$p"
  done | xargs
}

pkg_install() {
  echo -e "\e[32mInstalling packages:\e[0m"
  
  if [[ $PKG_MGR == "pacman" ]]; then
    notfound="$1"
    
    ### pacman
    local pacmanpkgs=$(filter_pacman "$notfound")
    echo -e "\e[32m\t::Installing via pacman: $pacmanpkgs\e[0m"
    [[ -n $pacmanpkgs ]] && sudo pacman -S --needed --noconfirm $pacmanpkgs
    notfound=$(diff_words "$notfound" "$pacmanpkgs")
    
    local installedpkgs=$(filter_installed "$pacmanpkgs")
    local notinstalledpkg=$(diff_words "$pacmanpkgs" "$installedpkgs")
    if [[ $notinstalledpkg != "" ]]; then
      echo -e "\e[31m\t::Not installing via pacman by unknown errors: $notinstalledpkg\e[0m"
    fi;

    ### yay
    if [[ $notfound != "" ]]; then
      local yaypkgs=$(filter_yay "$notfound")
      echo -e "\e[32m\t::Installing via AUR: $yaypkgs\e[0m"
      [[ -n $yaypkgs ]] && yay -S --needed --noconfirm $yaypkgs
      notfound=$(diff_words "$notfound" "$yaypkgs")
      
      local installedpkgs=$(filter_installed "$yaypkgs")
      local notinstalledpkg=$(diff_words "$yaypkgs" "$installedpkgs")
      if [[ $notinstalledpkg != "" ]]; then
      	echo -e "\e[31m\t::Not installing via AUR by unknown errors: $notinstalledpkg\e[0m"xt
      fi;
    fi;

    ### flatpak
    if [[ $notfound != "" ]]; then
      local flatpakpkgs=$(flatpak remote-ls flathub --app --columns=application 2>/dev/null | grep -Fxf <(printf '%s\n' $notfound) | xargs)
      echo -e "\e[32m\t::Installing via flatpak: $flatpakpkgs\e[0m"
      flatpak install flathub -y --or-update $flatpakpkgs
      notfound=$(diff_words "$notfound" "$flatpakpkgs")
      
      local installedpkgs=$(flatpak list --app --columns=application | xargs)
      local notinstalledpkg=""
      for p in $flatpakpkgs; do
        flatpak list --app --columns=application | grep -qxF "$p" || notinstalledpkg+="$p "
      done
    fi;

    if [[ $notfound != "" ]]; then
      echo -e "\e[31m\t::Not found at all: $notfound\e[0m"
    fi;
  fi;
}

pkg_install_json() {
  local names=("${PKG_NAMES[@]}")
  [[ ${#names[@]} -eq 0 ]] && return 0

  pkg_install "${names[*]}"

  echo -e "\e[32mRunning pre_install hooks:\e[0m"
  local flatpaks name
  flatpaks=$(flatpak list --app --columns=application 2>/dev/null)

  for name in "${names[@]}"; do
    [[ -n ${PKG_HOOKS[$name]:-} ]] || continue

    if ! pacman -Qq "$name" &>/dev/null && ! grep -qxF "$name" <<<"$flatpaks"; then
      echo -e "\e[33m\t::Skip hook for $name (not installed)\e[0m"
      continue
    fi

    echo -e "\e[32m\t::Hook: $name\e[0m"
    if ! ( eval "${PKG_HOOKS[$name]}" ); then
      echo -e "\e[31m\t::Hook failed: $name\e[0m"
    fi
  done
}
