#!/usr/bin/env bash

{{ template "statusbar.tmpl" . }}
{{ template "sudo.tmpl" . }}
{{ template "service.tmpl" . }}
{{ template "pkg_install.tmpl" . }}

# {{ include ".assets/packages.json" | sha256sum }}

status_start
status "Installing packages from packages.json"

export CHEZMOI_SOURCE_DIR="{{ .chezmoi.sourceDir }}"

declare -a PKG_NAMES=()
declare -A PKG_HOOKS=()
{{- range $name, $cfg := (include ".assets/packages.json" | fromJson) }}
{{- if or (not (hasKey $cfg "enabled")) $cfg.enabled }}
PKG_NAMES+=({{ $name | quote }})
{{- if hasKey $cfg "pre_install" }}
IFS= read -r -d '' _hook <<'__PKG_HOOK__' || true
{{ join "\n" $cfg.pre_install }}
__PKG_HOOK__
PKG_HOOKS[{{ $name | quote }}]=$_hook
{{- end }}
{{- end }}
{{- end }}

pkg_install_json

status_stop
