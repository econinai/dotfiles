font-family = "Liga SFMonoNerdFont"
font-size = 14.0

background-opacity = 1.0

window-padding-x = 10
window-padding-y = 10

confirm-close-surface = false

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor
custom-shader = "shaders/ghostty-cursor-shaders/cursor_warp.glsl"
custom-shader-animation = true

theme = noctalia

keybind = ctrl+c=unbind
keybind = ctrl+v=unbind
keybind = ctrl+shift+c=unbind
keybind = performable:ctrl+key_c=copy_to_clipboard
keybind = ctrl+key_v=paste_from_clipboard
keybind = ctrl+shift+key_c=text:\x03

working-directory = home
window-inherit-working-directory = false
